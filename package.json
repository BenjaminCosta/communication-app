{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "emulator": "JAVA_HOME=/usr/local/opt/openjdk@21 PATH=/usr/local/opt/openjdk@21/bin:$PATH firebase emulators:start --config firebase.emulator.json --import=./emulator-data --export-on-exit=./emulator-data",
    "emulator:clean": "JAVA_HOME=/usr/local/opt/openjdk@21 PATH=/usr/local/opt/openjdk@21/bin:$PATH firebase emulators:start --config firebase.emulator.json",
    "functions:build": "cd functions && pnpm install && pnpm build",
    "functions:watch": "cd functions && pnpm build:watch",
    "emulator:export": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/export-prod-to-emulator.mjs",
    "emulator:migrate": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/migrate-visible-to.mjs",
    "emulator:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed-test-cases.mjs",
    "emulator:verify": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/verify-test-cases.mjs",
    "emulator:migrate-categories": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/migrate-tag-categories.mjs",
    "emulator:test-categories": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/test-tag-categories.mjs",
    "emulator:test-calendar": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/test-calendar.mjs",
    "migrate:tags": "node scripts/normalize-tags-v1.mjs",
    "backfill:image-dims": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backfill-image-dims.mjs",
    "backfill:image-dims:dry": "DRY_RUN=1 GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backfill-image-dims.mjs",
    "inspect:tag-visibility": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/inspect-tag-visibility.mjs",
    "inspect:tag-visibility:prod": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/inspect-tag-visibility.mjs",
    "backfill:recipients:dry": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/backfill-explicit-recipients.mjs",
    "backfill:recipients": "DRY_RUN=false FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/backfill-explicit-recipients.mjs",
    "backfill:recipients:dry:prod": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backfill-explicit-recipients.mjs",
    "backfill:recipients:prod": "DRY_RUN=false CONFIRM_PROD_MIGRATION=true GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backfill-explicit-recipients.mjs",
    "backfill:recipients:verify": "VERIFY=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/backfill-explicit-recipients.mjs",
    "backfill:recipients:verify:prod": "VERIFY=true GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backfill-explicit-recipients.mjs",
    "backfill:calendar-date-strings": "node scripts/backfill-calendar-date-strings.mjs --prod",
    "backfill:calendar-date-strings:dry": "node scripts/backfill-calendar-date-strings.mjs --prod --dry-run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
