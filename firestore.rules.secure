// firestore.rules.secure
//
// SECURE RULES — TEST ONLY IN EMULATOR
// DO NOT deploy to production until all cases A–G pass in the emulator.
//
// Deploy to production only with explicit approval.
//
// Visibility model:
//   visibleToUserIds = author + direct recipients + members of all associated project-tags
//   Legacy fallback: participants field — BUT only for messages that don't have visibleToUserIds
//   (i.e. pre-migration messages). Once a message has visibleToUserIds, only that field counts.
//
// IMPORTANT: The participants fallback must NOT fire when visibleToUserIds exists,
// because participants may be corrupted to allUIDs from old recovery scripts.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can read the user list (needed for contact resolution).
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/recentJobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['jobId', 'viewedAt'])
                            && request.resource.data.jobId == jobId
                            && request.resource.data.viewedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Directory user state ───────────────────────────────────────────────
    match /users/{userId}/directoryFavorites/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['directoryId', 'favoritedAt'])
                            && request.resource.data.directoryId == entryId
                            && request.resource.data.favoritedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/directoryRecents/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['directoryId', 'viewedAt'])
                            && request.resource.data.directoryId == entryId
                            && request.resource.data.viewedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Projects (Tags) ────────────────────────────────────────────────────
    // Any authenticated user can read (tags are global/shared across all users).
    // Only the owner can create/delete. Only members can update.
    match /projects/{projectId} {
      allow read:   if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {

      // READ:
      //   - If visibleToUserIds exists → ONLY that field determines access.
      //     (participants may be corrupted — do NOT fall through to it)
      //   - If visibleToUserIds is absent (pre-migration legacy) → fall back to participants.
      allow read: if request.auth != null && (
        (
          'visibleToUserIds' in resource.data
          && request.auth.uid in resource.data.visibleToUserIds
        )
        ||
        (
          !('visibleToUserIds' in resource.data)
          && request.auth.uid in resource.data.get('participants', [])
        )
      );

      // CREATE: only the author can create, and must be in visibleToUserIds.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.get('authorId', request.resource.data.get('senderId', ''))
                    && request.auth.uid in request.resource.data.get('visibleToUserIds', []);

      // UPDATE: user must currently be able to see the message (same read logic)
      //         AND must be the author/sender.
      allow update: if request.auth != null
                    && (
                      (
                        'visibleToUserIds' in resource.data
                        && request.auth.uid in resource.data.visibleToUserIds
                      )
                      ||
                      (
                        !('visibleToUserIds' in resource.data)
                        && request.auth.uid in resource.data.get('participants', [])
                      )
                    )
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    )
                    // Source-linked Quest Coral thread messages are written
                    // atomically by the server bridge; client mutations would
                    // break the corresponding project-thread record.
                    && resource.data.get('sourceModule', '') != 'quest-coral';

      // DELETE: only the author/sender can delete their own message.
      allow delete: if request.auth != null
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    )
                    && resource.data.get('sourceModule', '') != 'quest-coral';
    }

    // ── Categories (user-created tag categories) ─────────────────────────
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Contexts (global — any auth user reads/creates/updates; only creator deletes) ──
    match /contexts/{contextId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Three-week outlooks (operational records under a source job) ───────
    match /contexts/{contextId}/outlooks/{outlookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.jobId == contextId
                    && request.resource.data.windowStart == outlookId
                    && request.resource.data.revision == 1;
      allow update: if request.auth != null
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.jobId == resource.data.jobId
                    && request.resource.data.jobDirectoryId == resource.data.jobDirectoryId
                    && request.resource.data.windowStart == resource.data.windowStart
                    && request.resource.data.windowEnd == resource.data.windowEnd
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.jobId == contextId
                      && request.resource.data.kind == 'published';
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdf']);
        allow delete: if false;
      }
    }

    // ── Imported Contacts ──────────────────────────────────────────────────
    // Contacts are global-only for now: any authenticated user can read every
    // contact. Writes stay owner-scoped (only the owner can create/update/delete).
    match /contacts/{contactId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUserId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUserId;
    }

    // ── Directory Index (derived, read-only) ───────────────────────────────
    // Derived from /contacts + /contexts, regenerated server-side by
    // scripts/generate-directory-index.mjs (Admin SDK bypasses these rules).
    // Any authenticated user may READ; clients may NEVER write.
    match /directoryIndex/{entryId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /directorySearchShards/{shardId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory metadata (schemaVersion, counts, lastChangeAt) ────────────
    match /directoryMeta/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory relations (derived, safe, confidence-gated) ───────────────
    // Any authenticated user may READ; clients may NEVER write (Admin SDK only).
    match /directoryRelations/{relationId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory reference data (curated lookups/catalogs) ─────────────────
    match /directoryReferenceData/{referenceId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory review queue — internal ops only (server/Admin SDK) ───────
    match /directoryReviewQueue/{issueId} {
      allow read, write: if false;
    }

    // ── Directory notes (operational knowledge, per entity) ─────────────────
    match /directoryNotes/{noteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Directory files (evidence/docs, per entity) ─────────────────────────
    match /directoryFiles/{fileId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uploadedBy == request.auth.uid;
    }

    // ── Directory control (import lock) — server/Admin SDK only ─────────────
    match /directoryControl/{docId} {
      allow read, write: if false;
    }
    // ── Applications ───────────────────────────────────────────────────────
    // DEPLOYED TO PRODUCTION 2026-07-24. Two audiences over one
    // collection, decided 2026-07-23:
    //   * Staff  = any authenticated user with NO applicationId claim. There
    //     are no reviewer roles, so the activity subcollection (with actorUid)
    //     is the audit trail.
    //   * Candidate = a link session, identified by a custom-token claim.
    // Defining staff by the ABSENCE of the claim is what stops a candidate
    // session from reviewing (and approving) its own application.
    function appIsStaff() {
      return request.auth != null && !('applicationId' in request.auth.token);
    }
    function appIsCandidate(applicationId) {
      return request.auth != null && request.auth.token.applicationId == applicationId;
    }
    // A candidate token carries the SHA-256 digest of the link that opened
    // their session. Check the current link record on every request so expiry
    // and revocation take effect even after Firebase has minted an ID token.
    function appHasActiveCandidateLink(applicationId) {
      return appIsCandidate(applicationId)
             && request.auth.token.applicationLinkHash is string
             && exists(/databases/$(database)/documents/applicationLinks/$(request.auth.token.applicationLinkHash))
             && get(/databases/$(database)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.applicationId == applicationId
             && get(/databases/$(database)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.revokedAt == null
             && get(/databases/$(database)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.expiresAt > request.time;
    }
    function appTouchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /applications/{applicationId} {
      allow read:   if appIsStaff() || appHasActiveCandidateLink(applicationId);
      allow create: if appIsStaff();
      allow update: if (
                      appIsStaff()
                      // State, identity and agreement transitions run through
                      // Admin SDK endpoints with an atomic activity event.
                      && appTouchesOnly(['general', 'video', 'documents', 'updatedAt'])
                    ) || (
                      appHasActiveCandidateLink(applicationId)
                      // Only while the ball is in their court.
                      && resource.data.status in ['draft', 'needs_information']
                      && appTouchesOnly(['general', 'video', 'documents', 'status', 'updatedAt', 'submittedAt'])
                      // Keep the status, or submit. Never anything else —
                      // this is what stops a candidate approving themselves.
                      && (
                        request.resource.data.status == resource.data.status
                        || request.resource.data.status == 'submitted'
                      )
                    );
      allow delete: if false;

      // Append-only history. Nothing edits or deletes an audit entry.
      match /activity/{eventId} {
        allow read:   if appIsStaff() || appHasActiveCandidateLink(applicationId);
        allow create: if (appIsStaff() && request.resource.data.actorUid == request.auth.uid)
                      || appHasActiveCandidateLink(applicationId);
        allow update, delete: if false;
      }
    }

    // Secure links. Resolving a token happens server-side (Admin SDK), so the
    // client can read nothing here — otherwise anyone could enumerate live
    // links and open someone else's application.
    match /applicationLinks/{tokenHash} {
      allow read:   if false;
      allow create, update: if appIsStaff();
      allow delete: if false;
    }

    // Signature evidence — written by the server only.
    match /applicationAgreements/{agreementId} {
      allow read:  if appIsStaff();
      allow write: if false;
    }

    // ── Quest Coral ──────────────────────────────────────────────────────────
    // Same policy as firestore.rules — no candidate-link concept here, so the
    // permissive/claim-gated split that Applications needs doesn't apply.
    // Kept identical in both rule files intentionally.
    match /questCoralProjects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUserId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUserId;
    }

    match /questCoralUpdates/{updateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorId
                    // Feedback is mirrored to Communications by the secure
                    // server command, so clients cannot create an unmirrored
                    // Feedback document directly.
                    && request.resource.data.type != 'feedback';
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.authorId;
    }

    // Replies are the Quest Coral projection of a Communications Feedback
    // thread. The server command creates both records atomically; clients
    // may only read the resulting conversation.
    match /questCoralFeedbackReplies/{replyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // One shared Markdown orientation brief per Quest Coral project. Keep it
    // separate from the immutable activity feed, but require the document id
    // and declared projectId to stay aligned on every client write.
    match /questCoralProjectContexts/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && exists(/databases/$(database)/documents/questCoralProjects/$(projectId))
                    && request.resource.data.projectId == projectId
                    && request.resource.data.markdown is string
                    && request.resource.data.markdown.size() <= 12000
                    && request.resource.data.updatedBy is string
                    && request.resource.data.source in ['manual', 'upload'];
      allow update: if request.auth != null
                    && request.resource.data.projectId == resource.data.projectId
                    && request.resource.data.projectId == projectId
                    && request.resource.data.markdown is string
                    && request.resource.data.markdown.size() <= 12000
                    && request.resource.data.updatedBy is string
                    && request.resource.data.source in ['manual', 'upload'];
      allow delete: if false;
    }

    // One private read marker per user/project. The count is materialized from
    // the append-only activity feed, while lastReadAt prevents replayed
    // snapshots from creating duplicate unread activity.
    match /questCoralProjectUnreadStates/{stateId} {
      // resource == null when the doc doesn't exist yet (first-ever read
      // marker for a user/project) — must allow, or transaction.get() on it
      // throws permission-denied before create/update can run.
      allow read: if request.auth != null
                  && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && exists(/databases/$(database)/documents/questCoralProjects/$(request.resource.data.projectId))
                    && stateId == request.auth.uid + "__" + request.resource.data.projectId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.projectId is string
                    && request.resource.data.unreadCount is int
                    && request.resource.data.unreadCount >= 0
                    && request.resource.data.unreadCount <= 10000
                    && (request.resource.data.lastReadAt == null || request.resource.data.lastReadAt is timestamp);
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.projectId == resource.data.projectId
                    && stateId == request.auth.uid + "__" + request.resource.data.projectId
                    && request.resource.data.unreadCount is int
                    && request.resource.data.unreadCount >= 0
                    && request.resource.data.unreadCount <= 10000
                    && (request.resource.data.lastReadAt == null || request.resource.data.lastReadAt is timestamp);
      allow delete: if false;
    }

    // Distributed AI rate limits, idempotency fingerprints and active leases
    // for Quest Coral's Ask AI. Server/Admin SDK only. Kept identical to
    // firestore.rules intentionally.
    match /questCoralAiUsage/{userHash} {
      allow read, write: if false;
    }

    // ── ByeByeDPR ─────────────────────────────────────────────────────────
    // Flat, single-org model (2026-08-10). Kept identical to firestore.rules
    // intentionally.
    match /jobs/{jobId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /clockRecords/{clockRecordId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorId
                    && request.resource.data.status == 'draft';
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.authorId
                    && resource.data.status == 'draft'
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if false;

      match /attachments/{attachmentId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uploadedBy
                      && get(/databases/$(database)/documents/reports/$(reportId)).data.authorId == request.auth.uid
                      && get(/databases/$(database)/documents/reports/$(reportId)).data.status == 'draft';
        allow update, delete: if false;
      }
    }

  }
}
