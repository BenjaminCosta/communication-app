rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Existing message image uploads.
    match /message-images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Files explicitly attached to Directory entities. V1 remains owner-write,
    // authenticated-read and accepts the document formats used by field teams.
    match /directory-files/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/(plain|csv)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── SVC Applications ────────────────────────────────────────────────────
    // Candidate uploads (documents + intro video), scoped by the same custom
    // token claim as the Firestore rules: only the candidate for THIS
    // application may write, any authenticated SVC user (staff) may read.
    function appIsStaff() {
      return request.auth != null && !('applicationId' in request.auth.token);
    }
    function appIsCandidate(applicationId) {
      return request.auth != null && request.auth.token.applicationId == applicationId;
    }
    // Mirror the Firestore gate for file bytes: a revoked or expired invite
    // must immediately lose access to documents and video too.
    function appHasActiveCandidateLink(applicationId) {
      return appIsCandidate(applicationId)
        && request.auth.token.applicationLinkHash is string
        && firestore.exists(/databases/(default)/documents/applicationLinks/$(request.auth.token.applicationLinkHash))
        && firestore.get(/databases/(default)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.applicationId == applicationId
        && firestore.get(/databases/(default)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.revokedAt == null
        && firestore.get(/databases/(default)/documents/applicationLinks/$(request.auth.token.applicationLinkHash)).data.expiresAt > request.time;
    }

    match /application-uploads/{applicationId}/documents/{allPaths=**} {
      allow read: if appIsStaff() || appHasActiveCandidateLink(applicationId);
      allow create, update: if appHasActiveCandidateLink(applicationId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
      allow delete: if appHasActiveCandidateLink(applicationId);
    }

    match /application-uploads/{applicationId}/video/{allPaths=**} {
      allow read: if appIsStaff() || appHasActiveCandidateLink(applicationId);
      allow create, update: if appHasActiveCandidateLink(applicationId)
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('video/.*');
      allow delete: if appHasActiveCandidateLink(applicationId);
    }

    // Sealed agreement PDFs — written by the server (Admin SDK) only; staff read.
    match /application-agreements/{applicationId}/{allPaths=**} {
      allow read: if appIsStaff() || appHasActiveCandidateLink(applicationId);
      allow write: if false;
    }
  }
}
