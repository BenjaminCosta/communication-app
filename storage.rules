rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Existing message image uploads.
    match /message-images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Files explicitly attached to Directory entities. V1 remains owner-write,
    // authenticated-read and accepts the document formats used by field teams.
    match /directory-files/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/(plain|csv)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── SVC Applications ────────────────────────────────────────────────────
    // Operational mode: any signed-in Firebase session can upload, view or
    // replace application media. This intentionally does not enforce claims,
    // expiration or revocation while the workflow is being stabilized.
    match /application-uploads/{applicationId}/documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /application-uploads/{applicationId}/video/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /application-agreements/{applicationId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
