// firestore.rules
//
// PRODUCTION RULES — deployed 2026-05-18
//
// Visibility model:
//   visibleToUserIds = author + direct recipients + members of all associated project-tags
//   Legacy fallback: participants field — BUT only for messages that don't have visibleToUserIds
//   (i.e. pre-migration messages). Once a message has visibleToUserIds, only that field counts.
//
// IMPORTANT: The participants fallback must NOT fire when visibleToUserIds exists,
// because participants may be corrupted to allUIDs from old recovery scripts.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can read the user list (needed for contact resolution).
    // Users can only write their own doc.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Projects (Tags) ────────────────────────────────────────────────────
    // Only project members can read. Owner can create/delete. Members can update.
    match /projects/{projectId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {

      // READ:
      //   - If visibleToUserIds exists → ONLY that field determines access.
      //     (participants may be corrupted — do NOT fall through to it)
      //   - If visibleToUserIds is absent (pre-migration legacy) → fall back to participants.
      allow read: if request.auth != null && (
        (
          'visibleToUserIds' in resource.data
          && request.auth.uid in resource.data.visibleToUserIds
        )
        ||
        (
          !('visibleToUserIds' in resource.data)
          && request.auth.uid in resource.data.get('participants', [])
        )
      );

      // CREATE: only the author can create, and must be in visibleToUserIds.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.get('authorId', request.resource.data.get('senderId', ''))
                    && request.auth.uid in request.resource.data.get('visibleToUserIds', []);

      // UPDATE: user must currently be able to see the message (same read logic)
      //         AND must be the author/sender.
      allow update: if request.auth != null
                    && (
                      (
                        'visibleToUserIds' in resource.data
                        && request.auth.uid in resource.data.visibleToUserIds
                      )
                      ||
                      (
                        !('visibleToUserIds' in resource.data)
                        && request.auth.uid in resource.data.get('participants', [])
                      )
                    )
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    );

      // DELETE: only the author/sender can delete their own message.
      allow delete: if request.auth != null
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    );
    }

    // ── Categories (user-created tag categories) ─────────────────────────
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Imported Contacts ──────────────────────────────────────────────────
    // Private by default. If visibility == "global", any authenticated user can read.
    // Only the owner can update, delete, or create.
    match /contacts/{contactId} {
      allow read: if request.auth != null && (
                    request.auth.uid == resource.data.ownerUserId ||
                    resource.data.visibility == "global"
                  );
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUserId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUserId;
    }
  }
}
