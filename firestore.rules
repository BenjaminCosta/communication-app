// firestore.rules
//
// PRODUCTION RULES — deployed 2026-05-18
//
// Visibility model:
//   visibleToUserIds = author + direct recipients + members of all associated project-tags
//   Legacy fallback: participants field — BUT only for messages that don't have visibleToUserIds
//   (i.e. pre-migration messages). Once a message has visibleToUserIds, only that field counts.
//
// IMPORTANT: The participants fallback must NOT fire when visibleToUserIds exists,
// because participants may be corrupted to allUIDs from old recovery scripts.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can read the user list (needed for contact resolution).
    // Users can only write their own doc.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Directory user state ───────────────────────────────────────────────
    // Favorites and recents are private, per-user state. They reference the
    // read-only composite ids from /directoryIndex but never mutate the index.
    match /users/{userId}/directoryFavorites/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['directoryId', 'favoritedAt'])
                            && request.resource.data.directoryId == entryId
                            && request.resource.data.favoritedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/directoryRecents/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['directoryId', 'viewedAt'])
                            && request.resource.data.directoryId == entryId
                            && request.resource.data.viewedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Projects (Tags) ────────────────────────────────────────────────────
    // Any authenticated user can read (tags are global/shared across all users).
    // Only the owner can create/delete. Only members can update.
    match /projects/{projectId} {
      allow read:   if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid == request.resource.data.ownerId;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {

      // READ:
      //   - If visibleToUserIds exists → ONLY that field determines access.
      //     (participants may be corrupted — do NOT fall through to it)
      //   - If visibleToUserIds is absent (pre-migration legacy) → fall back to participants.
      allow read: if request.auth != null && (
        (
          'visibleToUserIds' in resource.data
          && request.auth.uid in resource.data.visibleToUserIds
        )
        ||
        (
          !('visibleToUserIds' in resource.data)
          && request.auth.uid in resource.data.get('participants', [])
        )
      );

      // CREATE: only the author can create, and must be in visibleToUserIds.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.get('authorId', request.resource.data.get('senderId', ''))
                    && request.auth.uid in request.resource.data.get('visibleToUserIds', []);

      // UPDATE: user must currently be able to see the message (same read logic)
      //         AND must be the author/sender.
      allow update: if request.auth != null
                    && (
                      (
                        'visibleToUserIds' in resource.data
                        && request.auth.uid in resource.data.visibleToUserIds
                      )
                      ||
                      (
                        !('visibleToUserIds' in resource.data)
                        && request.auth.uid in resource.data.get('participants', [])
                      )
                    )
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    );

      // DELETE: only the author/sender can delete their own message.
      allow delete: if request.auth != null
                    && (
                      request.auth.uid == resource.data.get('authorId', '')
                      || request.auth.uid == resource.data.get('senderId', '')
                    );
    }

    // ── Categories (user-created tag categories) ─────────────────────────
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Contexts (global — any auth user reads/creates/updates; only creator deletes) ──
    match /contexts/{contextId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Imported Contacts ──────────────────────────────────────────────────
    // Contacts are global-only for now: any authenticated user can read every
    // contact. Writes stay owner-scoped (only the owner can create/update/delete).
    match /contacts/{contactId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUserId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUserId;
    }

    // ── Directory Index (derived, read-only) ───────────────────────────────
    // A lightweight index derived from /contacts + /contexts, regenerated
    // server-side by scripts/generate-directory-index.mjs (Admin SDK, which
    // bypasses these rules). Any authenticated user may READ; clients may
    // NEVER write — the collection is a projection, not a source of truth.
    match /directoryIndex/{entryId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Compact, deterministic catalog shards derived from directoryIndex.
    match /directorySearchShards/{shardId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory metadata (schemaVersion, counts, lastChangeAt) ────────────
    // Read-only signal clients use to invalidate their local MiniSearch cache.
    match /directoryMeta/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory relations (derived, safe, confidence-gated) ───────────────
    // Only fully-resolved, high-confidence relationships land here (ambiguous
    // ones stay in /directoryReviewQueue). Same access shape as the index:
    // any authenticated user may READ; clients may NEVER write (Admin SDK only).
    match /directoryRelations/{relationId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory reference data (curated lookups/catalogs) ─────────────────
    // Read-only shared reference values (e.g. statuses, project types).
    match /directoryReferenceData/{referenceId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── Directory review queue — internal ops only (server/Admin SDK) ───────
    // Ambiguous matches / pending exceptions. Not exposed to the client UI.
    match /directoryReviewQueue/{issueId} {
      allow read, write: if false;
    }

    // ── Directory notes (operational knowledge, per entity) ─────────────────
    // Separate flexible collection linked to entities by composite id in
    // entityIds. Global-readable; only the author can create/edit/delete.
    match /directoryNotes/{noteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── Directory files (evidence/docs, per entity) ─────────────────────────
    // Separate collection linked by entityIds; binaries live in Storage.
    // Global-readable; only the uploader can create/edit/delete the record.
    match /directoryFiles/{fileId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uploadedBy == request.auth.uid;
    }

    // ── Directory control (import lock) — server/Admin SDK only ─────────────
    match /directoryControl/{docId} {
      allow read, write: if false;
    }
  }
}
