rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read all profiles (needed for contacts list).
    // Only the owner can write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Projects: readable/writable only by members.
    // On create, the creator must be in the members array.
    // Only the owner (ownerId) can delete the project.
    match /projects/{projectId} {
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    // Messages: readable/writable by participants OR by members of the tagged project.
    // On create, the sender must be the authenticated user and must be a participant.
    match /messages/{messageId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isProjectMember() {
        return resource.data.projectId != null
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members;
      }
      allow read:   if request.auth != null && (isParticipant() || isProjectMember());
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && (isParticipant() || isProjectMember());
      allow delete: if request.auth != null && (isParticipant() || isProjectMember());
    }
  }
}
